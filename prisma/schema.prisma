// Prisma schema - Ay Gloria Bendita (blanqueria, deco y accesorios, Argentina)
//
// Modelo pensado para stock rotativo de telas: el Product es el "modelo"
// (ej: "Almohadon 40x40 con cierre") y cada Variant es una tela/diseño
// disponible hoy, con su propia foto y stock. Cuando una tela se agota se
// desactiva o queda en stock 0; el modelo sigue publicado con el resto.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MERCADOPAGO
  TRANSFERENCIA
  EFECTIVO
}

enum ShippingMethod {
  ENVIO_NACIONAL
  RETIRO
}

// Por donde entro la venta. WEB es la tienda online; el resto se cargan a
// mano desde el panel (venta manual).
enum SalesChannel {
  WEB
  INSTAGRAM
  LOCAL_MAYORISTA
  CONOCIDO
  FERIA
  OTRO
}

// OWNER ve todo (costos, ventas, clientes, usuarios). STAFF (ej. la community
// manager) solo carga productos, telas y fotos.
enum AdminRole {
  OWNER
  STAFF
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Precios en pesos argentinos (enteros, sin centavos)
  price           Int // precio minorista de lista (tarjeta / Mercado Pago)
  cashPrice       Int? // precio minorista efectivo/transferencia (opcional)
  wholesalePrice  Int? // precio unitario mayorista (opcional)
  wholesaleMinQty Int? // unidades minimas del producto para acceder al mayorista

  featured   Boolean  @default(false)
  active     Boolean  @default(true)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Costeo: minutos de confeccion + receta de materiales (ProductMaterial).
  laborMinutes Int @default(0)

  images     ProductImage[]
  variants   Variant[]
  materials  ProductMaterial[]
  orderItems OrderItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([categoryId])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  materials Material[]
  createdAt DateTime   @default(now())
}

// Insumo con su ULTIMO precio de compra. No se controla stock de insumos a
// proposito: solo precios, para que el costo de cada producto se recalcule
// solo cuando el proveedor aumenta.
model Material {
  id          String            @id @default(cuid())
  name        String
  unit        String // "metro", "unidad", "cm", "kg"...
  unitCost    Int // pesos por unidad
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes       String?
  active      Boolean           @default(true)
  recipeItems ProductMaterial[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([supplierId])
}

// Receta: cuanto de cada material lleva una unidad del producto.
model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float

  @@unique([productId, materialId])
  @@index([materialId])
}

// Parametros globales del costeo (una sola fila, id "default").
model CostSettings {
  id                      String   @id @default("default")
  ownerMonthlySalary      Int      @default(0) // lo que la duena quiere ganar por mes
  employeeDailyRate       Int      @default(30000) // jornal de la empleada
  employeeDaysPerWeek     Float    @default(3.5)
  productiveHoursPerMonth Int      @default(200) // horas de confeccion del taller por mes
  fixedMonthlyCosts       Int      @default(0) // CM, luz, packaging, publicidad...
  estimatedMonthlyUnits   Int      @default(100) // productos que se hacen por mes
  wholesaleMarginPercent  Int      @default(40)
  retailMultiplier        Float    @default(1.9) // minorista = mayorista x este factor
  mpFeePercent            Float    @default(6.5) // comision Mercado Pago
  updatedAt               DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  city        String?
  isWholesale Boolean  @default(false)
  notes       String?
  orders      Order[]
  createdAt   DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

// Una tela / diseño / color disponible de un producto.
model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // ej: "Floral terracota", "Lino natural", "Cuero suela"
  imageUrl   String?
  stock      Int         @default(0)
  priceDelta Int         @default(0) // ajuste sobre el precio del producto (puede ser negativo)
  active     Boolean     @default(true)
  order      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  customerName   String
  phone          String
  email          String?
  address        String?
  city           String?
  province       String?
  postalCode     String?
  shippingMethod ShippingMethod
  paymentMethod  PaymentMethod
  status         OrderStatus    @default(PENDING)
  channel        SalesChannel   @default(WEB)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  isWholesale    Boolean        @default(false) // algun item se cobro a precio mayorista
  total          Int
  notes          String?
  mpPaymentId    String?
  mpPreferenceId String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([channel])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String // snapshot por si el producto se borra
  variantLabel String?
  quantity     Int
  unitPrice    Int
  isWholesale  Boolean  @default(false)

  @@index([orderId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
}
