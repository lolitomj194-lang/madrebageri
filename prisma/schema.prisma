// Prisma schema - Ay Gloria Bendita (blanqueria, deco y accesorios, Argentina)
//
// Modelo pensado para stock rotativo de telas: el Product es el "modelo"
// (ej: "Almohadon 40x40 con cierre") y cada Variant es una tela/diseño
// disponible hoy, con su propia foto y stock. Cuando una tela se agota se
// desactiva o queda en stock 0; el modelo sigue publicado con el resto.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MERCADOPAGO
  TRANSFERENCIA
  EFECTIVO
}

enum ShippingMethod {
  ENVIO_NACIONAL
  RETIRO
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Precios en pesos argentinos (enteros, sin centavos)
  price           Int // precio minorista de lista (tarjeta / Mercado Pago)
  cashPrice       Int? // precio minorista efectivo/transferencia (opcional)
  wholesalePrice  Int? // precio unitario mayorista (opcional)
  wholesaleMinQty Int? // unidades minimas del producto para acceder al mayorista

  featured   Boolean  @default(false)
  active     Boolean  @default(true)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  variants   Variant[]
  orderItems OrderItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

// Una tela / diseño / color disponible de un producto.
model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // ej: "Floral terracota", "Lino natural", "Cuero suela"
  imageUrl   String?
  stock      Int         @default(0)
  priceDelta Int         @default(0) // ajuste sobre el precio del producto (puede ser negativo)
  active     Boolean     @default(true)
  order      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  customerName   String
  phone          String
  email          String?
  address        String?
  city           String?
  province       String?
  postalCode     String?
  shippingMethod ShippingMethod
  paymentMethod  PaymentMethod
  status         OrderStatus    @default(PENDING)
  isWholesale    Boolean        @default(false) // algun item se cobro a precio mayorista
  total          Int
  notes          String?
  mpPaymentId    String?
  mpPreferenceId String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String // snapshot por si el producto se borra
  variantLabel String?
  quantity     Int
  unitPrice    Int
  isWholesale  Boolean  @default(false)

  @@index([orderId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
